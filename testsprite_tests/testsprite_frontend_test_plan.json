  {
    "id": "TC013",
    "title": "Create a new skill category successfully",
    "description": "Verifies an admin can add a new skill category and see it appear in the categories list.",
    "category": "Skill Categories Management",
    "priority": "High",
    "steps": [
      {
        "type": "action",
        "description": "Navigate to /admin/login"
      },
      {
        "type": "action",
        "description": "Type \"{{LOGIN_USER}}\" into the email field"
      },
      {
        "type": "action",
        "description": "Type \"{{LOGIN_PASSWORD}}\" into the password field"
      },
      {
        "type": "action",
        "description": "Click the \"Login\" button"
      },
      {
        "type": "assertion",
        "description": "Verify URL contains \"/admin\""
      },
      {
        "type": "action",
        "description": "Click on \"Categories\" in the admin navigation"
      },
      {
        "type": "assertion",
        "description": "Verify URL contains \"/admin/categories\""
      },
      {
        "type": "action",
        "description": "Click the \"Add Category\" button"
      },
      {
        "type": "action",
        "description": "Type \"Automation Category A\" into the category name field"
      },
      {
        "type": "action",
        "description": "Type \"code\" into the icon name field"
      },
      {
        "type": "action",
        "description": "Type \"Category created by end-to-end test\" into the description field"
      },
      {
        "type": "action",
        "description": "Click the submit button"
      },
      {
        "type": "assertion",
        "description": "Verify text \"Automation Category A\" is visible"
      }
    ]
  },
